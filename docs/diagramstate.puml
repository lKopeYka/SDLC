@startuml
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam nodesep 95
skinparam ranksep 65
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12

skinparam state {
  BackgroundColor White
  BorderColor Black
  BorderThickness 1.3
  FontStyle Bold
}

skinparam arrow {
  Color Black
  Thickness 1.2
}

[*] --> Init

state "Инициализация" as Init
Init : вход / проверка сессии и каталога

state "Проверка плана и оценок" as CheckState
CheckState : вход / загрузка статусов пользователя

Init -right-> CheckState : \n[JWT валиден]\n 
Init --> ActiveWork : [гость / без сессии]
CheckState --> ActiveWork : [статусы загружены]

state "Активная работа (ActiveSession)" as ActiveWork {
  [*] --> Idle

  state "Ожидание (Idle)" as Idle
  Idle : выполнение / отображение каталога и карточек

  state "В плане (Planned)" as Planned
  Planned : вход / status = Planned; без дублей

  state "Просмотрено (Watched)" as Watched
  Watched : вход / status = Watched; без плана

  state "Оценка и отзыв (Rated)" as Rated
  Rated : вход / оценка (1..10); пересчёт средней

  Idle --> Planned :addToWatchlist    \n[не в архиве]
  Planned --> Idle 

  Idle --> Watched : markWatched()  
  Watched --> Idle : \n[обновлено]

  Idle --> Rated : rateMovie(1..10)
  Rated --> Idle : \n[версия обновлена]
}

state "Завершение работы" as Finish
Finish : вход / закрытие сессии и фиксация данных

ActiveWork --> Finish : logout() / closeSession()
Finish --> [*]
@enduml
